{
  "cases": [
    {
      "name": "eof-json",
      "args": ["--stats", "--output=json", "--threads=1"],
      "stdin": "a\nb\n",
      "exit": 0,
      "format": "json",
      "expect": {"bytes_read": 4, "complete": true, "records": 2, "stop_reason": "eof"}
    },
    {
      "name": "eof-text",
      "args": ["--stats", "--output=raw", "--threads=1"],
      "stdin": "a\nb\n",
      "exit": 0,
      "format": "text",
      "expect": {"bytes_read": 4, "complete": true, "records": 2, "stop_reason": "eof"}
    },
    {
      "name": "eof-empty-input",
      "args": ["--stats", "--agent", "--threads=1"],
      "stdin": "",
      "exit": 0,
      "format": "json",
      "expect": {"bytes_read": 0, "complete": true, "records": 0, "stop_reason": "eof"}
    },
    {
      "name": "eof-two-workers",
      "args": ["--stats", "--output=json", "--threads=2"],
      "stdin": "a\nb\nc\n",
      "exit": 0,
      "format": "json",
      "expect": {"bytes_read": 6, "complete": true, "records": 3, "stop_reason": "eof"}
    },
    {
      "name": "eof-below-limit",
      "args": ["--stats", "--agent", "--limit=5", "--threads=1"],
      "stdin": "a\nb\nc\n",
      "exit": 0,
      "format": "json",
      "expect": {"bytes_read": 6, "complete": true, "records": 3, "stop_reason": "eof"}
    },
    {
      "name": "eof-no-match",
      "args": ["--stats", "--output=json", "--threads=1", "--where=level=ERROR"],
      "stdin": "{\"level\":\"info\",\"msg\":\"y\"}\n",
      "exit": 0,
      "format": "json",
      "expect": {"bytes_read": 27, "complete": true, "records": 0, "stop_reason": "eof"}
    },
    {
      "name": "eof-unsatisfied-assertion",
      "args": ["--stats", "--expect-some", "--errors-only", "--threads=1"],
      "stdin": "hello\n",
      "exit": 3,
      "format": "text",
      "expect": {"bytes_read": 6, "complete": true, "records": 0, "stop_reason": "eof"}
    },
    {
      "name": "limit-json",
      "args": ["--stats", "--agent", "--limit=2", "--threads=1"],
      "stdin": "a\nb\nc\n",
      "exit": 0,
      "format": "json",
      "expect": {"complete": true, "records": 2, "stop_reason": "limit"}
    },
    {
      "name": "limit-exact",
      "args": ["--stats", "--output=json", "--limit=3", "--threads=1"],
      "stdin": "a\nb\nc\n",
      "exit": 0,
      "format": "json",
      "expect": {"complete": true, "records": 3, "stop_reason": "limit"}
    },
    {
      "name": "limit-parallel-text",
      "args": ["--stats", "--output=raw", "--filter=line>=1", "--limit=1", "--threads=4"],
      "stdin": "a\nb\nc\n",
      "exit": 0,
      "format": "text",
      "expect": {"complete": true, "records": 1, "stop_reason": "limit"}
    },
    {
      "name": "error-missing-input",
      "args": ["--stats", "--output=json", "--threads=1", "/nonexistent/lumtail-stop-missing.log"],
      "stdin": "",
      "exit": 1,
      "format": "json",
      "expect": {"bytes_read": 0, "complete": false, "records": 0, "stop_reason": "error"}
    },
    {
      "name": "error-after-records-text",
      "args": ["--stats", "--output=raw", "--threads=1", "-", "/nonexistent/lumtail-stop-missing.log"],
      "stdin": "a\n",
      "exit": 1,
      "format": "text",
      "expect": {"bytes_read": 2, "complete": false, "records": 1, "stop_reason": "error"}
    },
    {
      "name": "error-truncation",
      "args": ["--stats", "--agent", "--fail-on-truncation", "--max-message-bytes=8", "--threads=1"],
      "stdin": "short\nthis message is longer than eight bytes\n",
      "exit": 1,
      "format": "json",
      "expect": {"complete": false, "records": 1, "stop_reason": "error"}
    }
  ],
  "follow_cases": [
    {
      "name": "duration-follow",
      "args": ["--stats", "--output=json", "--threads=1", "--follow", "--duration-ms=200"],
      "content": "one\ntwo\n",
      "expect": {"bytes_read": 8, "complete": true, "records": 2, "stop_reason": "duration"}
    },
    {
      "name": "duration-follow-text",
      "args": ["--stats", "--output=raw", "--threads=1", "--follow", "--duration-ms=200"],
      "content": "one\n",
      "expect": {"bytes_read": 4, "complete": true, "records": 1, "stop_reason": "duration"}
    }
  ],
  "silent_cases": [
    {
      "name": "stats-version-is-not-an-option",
      "args": ["--stats", "--stats-version=2"],
      "exit": 2
    }
  ]
}
