{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lumtail:agent:v1",
  "title": "Lumtail agent record v1",
  "type": "object",
  "required": [
    "timestamp",
    "level",
    "message",
    "file",
    "line",
    "format"
  ],
  "additionalProperties": false,
  "properties": {
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "level": {
      "enum": [
        "UNKNOWN",
        "TRACE",
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR",
        "CRITICAL"
      ]
    },
    "message": {
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "format": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.@%-]{1,128}$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "truncated": {
      "const": true
    },
    "truncated_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "enum": [
              "timestamp",
              "message",
              "file",
              "format"
            ]
          },
          {
            "type": "string",
            "pattern": "^fields\\.[A-Za-z0-9_.@%-]{1,128}$"
          }
        ]
      }
    }
  },
  "dependentRequired": {
    "truncated": [
      "truncated_fields"
    ],
    "truncated_fields": [
      "truncated"
    ]
  }
}
