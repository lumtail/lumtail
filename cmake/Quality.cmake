include_guard(GLOBAL)

option(LUMTAIL_WARNINGS_AS_ERRORS "Treat project compiler warnings as errors" OFF)
option(LUMTAIL_SANITIZERS "Enable the selected address/undefined behavior sanitizers" OFF)
set(LUMTAIL_SANITIZER_SET "address,undefined" CACHE STRING
  "Sanitizer selection: address, undefined, or address,undefined")
set_property(CACHE LUMTAIL_SANITIZER_SET PROPERTY STRINGS address undefined "address,undefined")
if(NOT LUMTAIL_SANITIZER_SET MATCHES "^(address|undefined|address,undefined)$")
  message(FATAL_ERROR "LUMTAIL_SANITIZER_SET must be address, undefined, or address,undefined.")
endif()
string(REPLACE "," "_" lumtail_sanitizer_key "${LUMTAIL_SANITIZER_SET}")
option(LUMTAIL_HARDENING "Enable supported compiler/linker hardening" ON)
option(LUMTAIL_FUZZING "Build the Clang/libFuzzer harnesses" OFF)
option(LUMTAIL_EXTERNAL_FUZZING "Use a fuzzing runner's compiler and sanitizer flags" OFF)
option(LUMTAIL_COVERAGE "Instrument source coverage" OFF)
option(LUMTAIL_THREAD_SANITIZER "Enable ThreadSanitizer in a separate build" OFF)
if(LUMTAIL_EXTERNAL_FUZZING AND
    (NOT LUMTAIL_FUZZING OR LUMTAIL_SANITIZERS OR LUMTAIL_THREAD_SANITIZER OR LUMTAIL_COVERAGE))
  message(FATAL_ERROR "External fuzzing requires LUMTAIL_FUZZING=ON and separate runner-provided instrumentation; disable LUMTAIL_SANITIZERS, LUMTAIL_THREAD_SANITIZER and LUMTAIL_COVERAGE.")
endif()
if(LUMTAIL_THREAD_SANITIZER AND (LUMTAIL_SANITIZERS OR LUMTAIL_FUZZING))
  message(FATAL_ERROR "ThreadSanitizer must use a separate build from ASan and fuzzing.")
endif()

if((LUMTAIL_SANITIZERS OR LUMTAIL_FUZZING) AND NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
  message(FATAL_ERROR "Sanitizers require GCC or Clang.")
endif()
if(LUMTAIL_FUZZING AND NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang|AppleClang")
  message(FATAL_ERROR "LUMTAIL_FUZZING requires Clang and a libFuzzer runtime.")
endif()

add_library(lumtail_options INTERFACE)
add_library(lumtail_instrumentation INTERFACE)
target_link_libraries(lumtail_options INTERFACE lumtail_instrumentation)
include(CheckCXXCompilerFlag)
check_cxx_compiler_flag(-fno-exceptions LUMTAIL_HAS_NO_EXCEPTIONS)
if(NOT LUMTAIL_HAS_NO_EXCEPTIONS)
  message(FATAL_ERROR "lumtail requires compiler support for -fno-exceptions.")
endif()
target_compile_options(lumtail_instrumentation INTERFACE -fno-exceptions)
target_compile_definitions(lumtail_instrumentation INTERFACE
  JSON_NOEXCEPTION=1 SIMDJSON_EXCEPTIONS=0)
target_compile_options(lumtail_options INTERFACE
  $<$<CXX_COMPILER_ID:GNU,Clang,AppleClang>:-Wall;-Wextra;-Wpedantic;-Wshadow;-Wformat=2;-Wconversion;-Wsign-conversion;-Wundef;-Wcast-qual;-Wnull-dereference;-Wdouble-promotion>)
target_compile_definitions(lumtail_options INTERFACE _GLIBCXX_ASSERTIONS=1)
if(LUMTAIL_WARNINGS_AS_ERRORS)
  target_compile_options(lumtail_options INTERFACE
    $<$<CXX_COMPILER_ID:GNU,Clang,AppleClang>:-Werror>)
endif()
if(LUMTAIL_HARDENING)
  include(CheckCXXCompilerFlag)
  check_cxx_compiler_flag(-fstack-protector-strong LUMTAIL_HAS_STACK_PROTECTOR)
  if(LUMTAIL_HAS_STACK_PROTECTOR)
    target_compile_options(lumtail_options INTERFACE -fstack-protector-strong)
  endif()
  include(CMakePushCheckState)
  cmake_push_check_state(RESET)
  if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    set(CMAKE_REQUIRED_FLAGS "-Werror")
  endif()
  check_cxx_compiler_flag(-fstack-clash-protection LUMTAIL_ACCEPTS_STACK_CLASH_PROTECTION)
  if(LUMTAIL_ACCEPTS_STACK_CLASH_PROTECTION)
    target_compile_options(lumtail_options INTERFACE -fstack-clash-protection)
  endif()
  # Probe fortify per mode because instrumentation changes it.
  set(lumtail_fortify_check LUMTAIL_TOOLCHAIN_FORTIFY)
  if(LUMTAIL_EXTERNAL_FUZZING)
    # Discard a probe when external sanitizer flags change.
    set(lumtail_fortify_check LUMTAIL_TOOLCHAIN_FORTIFY_EXTERNAL_FUZZING)
    unset(${lumtail_fortify_check} CACHE)
  elseif(LUMTAIL_SANITIZERS OR LUMTAIL_FUZZING)
    string(APPEND CMAKE_REQUIRED_FLAGS " -fsanitize=${LUMTAIL_SANITIZER_SET}")
    set(lumtail_fortify_check "LUMTAIL_TOOLCHAIN_FORTIFY_${lumtail_sanitizer_key}")
  elseif(LUMTAIL_THREAD_SANITIZER)
    string(APPEND CMAKE_REQUIRED_FLAGS " -fsanitize=thread")
    set(lumtail_fortify_check LUMTAIL_TOOLCHAIN_FORTIFY_TSAN)
  endif()
  check_cxx_source_compiles("
    #ifndef _FORTIFY_SOURCE
    #error Fortify is not configured by the toolchain
    #endif
    int main() { return 0; }
  " ${lumtail_fortify_check})
  cmake_pop_check_state()
  if(NOT ${lumtail_fortify_check} AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_definitions(lumtail_options INTERFACE
      $<$<CONFIG:Release,RelWithDebInfo,MinSizeRel>:_FORTIFY_SOURCE=2>)
  endif()
  if(NOT APPLE)
    include(CheckLinkerFlag)
    check_linker_flag(CXX "LINKER:-z,relro,-z,now" LUMTAIL_HAS_RELRO)
    if(LUMTAIL_HAS_RELRO)
      target_link_options(lumtail_options INTERFACE "LINKER:-z,relro,-z,now")
    endif()
    check_linker_flag(CXX "LINKER:-z,noexecstack" LUMTAIL_HAS_NOEXECSTACK)
    if(LUMTAIL_HAS_NOEXECSTACK)
      target_link_options(lumtail_options INTERFACE "LINKER:-z,noexecstack")
    endif()
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    include(CheckPIESupported)
    check_pie_supported(LANGUAGES CXX)
  endif()
endif()
if((LUMTAIL_SANITIZERS OR LUMTAIL_FUZZING) AND NOT LUMTAIL_EXTERNAL_FUZZING)
  include(CheckLinkerFlag)
  set(lumtail_sanitizer_check "LUMTAIL_HAS_SANITIZERS_${lumtail_sanitizer_key}")
  check_linker_flag(CXX "-fsanitize=${LUMTAIL_SANITIZER_SET}" ${lumtail_sanitizer_check})
  if(NOT ${lumtail_sanitizer_check})
    message(FATAL_ERROR "The selected sanitizer runtimes are unavailable: ${LUMTAIL_SANITIZER_SET}.")
  endif()
  target_compile_options(lumtail_instrumentation INTERFACE -fsanitize=${LUMTAIL_SANITIZER_SET}
    -fno-sanitize-recover=all -fno-omit-frame-pointer -fno-optimize-sibling-calls)
  if(LUMTAIL_SANITIZER_SET MATCHES "address")
    target_compile_options(lumtail_instrumentation INTERFACE -fsanitize-address-use-after-scope)
  endif()
  target_link_options(lumtail_instrumentation INTERFACE -fsanitize=${LUMTAIL_SANITIZER_SET} -fno-sanitize-recover=all)
endif()
if(LUMTAIL_THREAD_SANITIZER)
  include(CheckLinkerFlag)
  check_linker_flag(CXX "-fsanitize=thread" LUMTAIL_HAS_TSAN)
  if(NOT LUMTAIL_HAS_TSAN)
    message(FATAL_ERROR "ThreadSanitizer compiler runtime is unavailable.")
  endif()
  target_compile_options(lumtail_instrumentation INTERFACE -fsanitize=thread -fno-omit-frame-pointer)
  target_link_options(lumtail_instrumentation INTERFACE -fsanitize=thread)
endif()
if(LUMTAIL_FUZZING AND NOT LUMTAIL_EXTERNAL_FUZZING)
  target_compile_options(lumtail_instrumentation INTERFACE -fsanitize=fuzzer-no-link)
  target_link_options(lumtail_instrumentation INTERFACE -fsanitize=fuzzer-no-link)
endif()
if(LUMTAIL_COVERAGE)
  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    target_compile_options(lumtail_instrumentation INTERFACE -fprofile-instr-generate -fcoverage-mapping)
    target_link_options(lumtail_instrumentation INTERFACE -fprofile-instr-generate)
  elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    target_compile_options(lumtail_instrumentation INTERFACE --coverage)
    target_link_options(lumtail_instrumentation INTERFACE --coverage)
  else()
    message(FATAL_ERROR "Coverage requires GCC or Clang.")
  endif()
endif()
